# Copy to .env and fill in. .env is gitignored. Never commit real values.

# --- Rhombus AI
RHOMBUS_BASE_URL=https://rhombusai.com/
RHOMBUS_PROJECT_NAME=rhombus-qa-etl
RHOMBUS_PROJECT_URL=
RHOMBUS_SCRATCH_PROJECT_NAME=rhombus-qa-scratch
RHOMBUS_STORAGE_STATE=.auth/state.json

# --- AWS S3 (source). This is YOUR uploader identity, not the one Rhombus uses.
AWS_PROFILE=rhombus-qa-uploader
AWS_REGION=ap-southeast-2
S3_BUCKET=
S3_KEY=pipeline/orders.csv

# --- Google Cloud Storage (destination)
GCP_PROJECT_ID=
GCS_BUCKET=
GCS_OUTPUT_PREFIX=orders_clean
# read-only key used by the validator (absolute path, OUTSIDE the repo)
GOOGLE_APPLICATION_CREDENTIALS=/Users/YOUR_USER/.rhombus-qa-keys/qa-reader-key.json
